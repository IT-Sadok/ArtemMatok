{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "route_to_monolith": {
        "ClusterId": "monolith_cluster",
        "Match": {
          "Path": "/api/apartments/{**catch-all}"
        }
      },
      "route_to_audit": {
        "ClusterId": "audit_cluster",
        "Match": {
          "Path": "/api/Audits/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "monolith_cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "monolith_api": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "audit_cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "audit_api": {
            "Address": "http://localhost:5002"
          },
          "audit_api2": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
